{
  "name": "@attractor/backend-pi-dev",
  "version": "0.1.0",
  "description": "LLM backend adapter for Attractor pipelines",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://artifactory.epam.com/artifactory/api/npm/epm-dce-npm/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests --exclude '**/smoke-*'",
    "test:smoke": "vitest run --passWithNoTests smoke-test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@attractor/core": "0.1.0",
    "@mariozechner/pi-agent-core": "^0.67.3",
    "@mariozechner/pi-ai": "^0.67.3",
    "@mariozechner/pi-coding-agent": "^0.67.3",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@sinclair/typebox": "^0.34.0",
    "glob": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
